{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: 构建 Debug",
            "type": "shell",
            "command": "cmake --build --preset Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: 配置 Debug",
            "type": "shell",
            "command": "cmake --preset Debug",
            "problemMatcher": []
        },
        {
            "label": "CMake: 清理并重建",
            "type": "shell",
            "command": "rm -rf build/Debug && cmake --preset Debug && cmake --build --preset Debug",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "OpenOCD: 烧录",
            "type": "shell",
            "command": "openocd -f flash.cfg",
            "problemMatcher": []
        }
    ]
}